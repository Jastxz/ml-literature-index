{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jastxz/ml-literature-index/blob/main/schema/paper.schema.json",
  "title": "ML Literature Index paper record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_key",
    "identifiers",
    "title",
    "authors",
    "authors_complete",
    "publication_year",
    "topics",
    "paper_url",
    "source_records",
    "evidence_available"
  ],
  "properties": {
    "work_key": {
      "type": "string",
      "pattern": "^(doi|arxiv|openalex):.+$"
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": {
          "type": "string",
          "minLength": 3
        },
        "arxiv_id": {
          "type": "string",
          "minLength": 5
        },
        "openalex_id": {
          "type": "string",
          "pattern": "^W[0-9]+$"
        }
      },
      "minProperties": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authors_complete": {
      "type": "boolean"
    },
    "publication_year": {
      "type": "integer",
      "minimum": 1600,
      "maximum": 2100
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "paper_url": {
      "type": "string",
      "format": "uri"
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_record_id",
          "url",
          "retrieved_at"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "evidence_available": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "metadata",
          "abstract",
          "full_text_at_source"
        ]
      }
    },
    "abstract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_id",
        "license_id",
        "license_url",
        "source_url"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string"
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "open_access_full_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "license_id",
        "license_url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "related_identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "doi"
        ],
        "properties": {
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "doi": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url",
          "source_id"
        ],
        "properties": {
          "kind": {
            "enum": [
              "code",
              "benchmark",
              "dataset"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
